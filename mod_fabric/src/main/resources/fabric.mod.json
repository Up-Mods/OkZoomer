{
	"schemaVersion": 1,
	"id": "ok_zoomer",
	"version": "${version}",
	"name": "Ok Zoomer",
	"description": "A zoom mod that is powerful, lean, and pretty customizable. The zoom is yours!",
	"authors": [
		"Ennui Langeweile",
		"Up"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/aXf2OSFU",
		"issues": "https://github.com/Up-Mods/OkZoomer/issues",
		"sources": "https://github.com/Up-Mods/OkZoomer"
	},
	"icon": "assets/ok_zoomer/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"page.langeweile.ok_zoomer.fabric.OkZoomerClientMod"
		],
		"modmenu": [
			"page.langeweile.ok_zoomer.fabric.config.modmenu.OkZoomerModMenuEntry"
		],
		"preLaunch": [
			"page.langeweile.ok_zoomer.fabric.OkZoomerPreLaunchMod"
		],
		"sodium:config_api_user": [
			"page.langeweile.ok_zoomer.config.sodium.OkZoomerSodiumEntry"
		]
	},
	"mixins": [
		"ok_zoomer.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": ">=26.2-",
		"fabric-api": ">=0.150.3"
	},
	"jars": [
		{
			"file": "META-INF/jarjar/ww_impl-0.9.1.jar"
		}
	],
	"custom": {
		"vmp:incompatibleConfig": [
			"use_optimized_entity_tracking"
		]
	}
}
